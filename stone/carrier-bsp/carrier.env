# Carrier-BSP env consumed by stone-provision-tegraflash.sh.
#
# Advantech MIC-742 — Jetson AGX Thor T4000 (P3834-0000 CVM) on the same
# Advantech P4071-class carrier as the MIC-743.
#
# Generic knob shape:
#   CARRIER_FV_<NAME>=value   → patches <NAME> in flashvars
#   CARRIER_ENV_<NAME>=value  → patches <NAME> in .env.initrd-flash
# Keys must start in column 0 — the rewrite loop strips the CARRIER_FV_/
# CARRIER_ENV_ prefix off the raw key, so a leading space makes it a no-op.
#
# READ THIS BEFORE TRUSTING THE T4000 BLOCK BELOW
# ------------------------------------------------
# The carrier half of this file is hardware-verified: it is byte-identical to
# the MIC-743's, and the MIC-743 was introspected on real hardware.
#
# The MODULE half is NOT hardware-verified. Advantech's shipped SDK is labelled
# MIC-742 but its flash SOP only ever runs the T5000 profile
# (jetson-agx-thor-devkit → p3834-0008-p4071-0000-nvme.conf), so it contains no
# T4000 flash configuration to copy. The values below are derived from NVIDIA's
# own p3834-0000-p4071-0000-nvme.conf in the same R39.2.0 BSP, which is exactly
# how L4T selects a T4000. Supporting evidence that a T4000 variant is real:
# Advantech shipped tegra264-p4071-0000+p3834-0000-nv.dtb carrying the SAME
# carrier patch as the T5000 DTB, which they would not have built otherwise.
#
# Every file referenced below already ships in tegraflash-bsp for this MACHINE
# (verified against the built deploy dir), so only the BPMP DTB is shipped here.
# Flash a T4000 and confirm before treating this as proven.

CARRIER_LABEL="Advantech MIC-742 (Jetson AGX Thor T4000, P3834-0000)"

# --- Carrier files shadowing the MACHINE-baked stock names ------------------
#
# Identical to the MIC-743 — these are p3834-xxxx / carrier-side files and do
# not vary with the module SKU. They ship here under their STOCK filenames and
# clobber the tegraflash-bsp copies; no CARRIER_FV_ override is needed.
# meta-tegra's generated `.dts` wrappers #include the pinmux/gpio `.dtsi` by
# name, so renaming them would orphan the include.
#
#   tegra264-mb1-bct-pinmux-p3834-xxxx-p4071-0000.dtsi  (61 pin blocks)
#   tegra264-mb1-bct-gpio-p3834-xxxx-p4071-0000.dtsi    (boot GPIO defaults)
#   tegra264-mb1-bct-prod-p3834-xxxx-p4071-0000.dts     (I2C1 drive strength,
#                                                        NVIDIA bug 5459342)

# --- Kernel DT overlay (shared with the MIC-743) ----------------------------
#
# Replaces OVERLAY_DTB_FILE (tegra264-ftpm.dtbo). The overlay is the same file
# the MIC-743 ships: Advantech's kernel-DT carrier delta is byte-identical
# between the T5000 and T4000 DTBs, which is the whole reason this is an
# overlay and not two forked 256KB DTBs. See tegra264-mic-74x-carrier.dts for
# the per-fragment rationale, including why it replaces the fTPM overlay
# (discrete Infineon SLB9670 on SPI2 CS0 — two TPMs would race for /dev/tpm0).
CARRIER_FV_OVERLAY_DTB_FILE="tegra264-mic-74x-carrier.dtbo"

# --- PCIe C3 / SATA (shared with the MIC-743) -------------------------------
#
# The carrier's ASMedia ASM106x SATA AHCI controller sits on PCIe C3, which the
# devkit leaves disabled. Bringing it up takes THREE coordinated settings; miss
# any one and BPMP aborts at boot with
#
#   FATAL ERROR [FILE=platform/drivers/pcie/pcie4.c, ERR_UID=5213]:
#     PCIe(3): is enabled in DT without enabling it in UPHY DT
#
# which then cascades into "BPMP firmware is not ready" and a BL31 ASSERT at
# plat/nvidia/tegra/soc/t264/plat_setup.c:726 -- i.e. the board never reaches
# the kernel. The three settings are:
#
#   1. /uphy/uphy0-config = 6 in the BPMP DTB. This is the UPHY lane map that
#      includes PCIe C3; stock (and Advantech's own DTB on disk) ship 7.
#   2. /pcie/pcie@3 status = "okay" in the BPMP DTB.
#   3. pcie@a808440000 status = "okay" in the kernel DTB (overlay fragment@1).
#
# BOTH BPMP properties are baked into the carrier BPMP DTB shipped here, so
# correctness does not depend on flash-time string handling. Advantech instead
# leaves uphy0-config at 7 on disk and relies on ODMDATA to patch it: tegraflash's
# tegraflash_update_bpmp_dtb() (bootloader/tegraflash_impl_t264.py) rewrites
# uphy0-config and the pcie@N status nodes in the BPMP DTB from --odmdata.
#
# That does NOT work on the avocado flash path today. initrd-flash.sh sources
# .env.initrd-flash WITHOUT exporting it, and sign_binaries() -- the function
# that actually generates and signs the flash images -- omits ODMDATA from its
# `VAR=value cmd` env prefix (create_rcm_boot_script() includes it; the bare
# `$ODMDATA` in the positional list is ignored, since the helper reads only
# three positionals). So $ODMDATA is empty inside tegra-flash-helper.sh, no
# --odmdata is passed, and the BPMP DTB is never patched. Verified on a
# MIC-743: ODMDATA was correctly rewritten in .env.initrd-flash and still had
# no effect, leaving uphy0-config at 7 and bricking the boot as above.
#
# ODMDATA is kept below anyway: it is Advantech's documented intent, it is
# harmless while inert, and if the initrd-flash export is ever fixed it sets
# exactly the two values already baked in -- so the two agree either way.
#
# UPHY_CONFIG is cleared to match Advantech. The MB1 UPHY BCT
# (tegra264-mb1-bct-uphy-lanes-p4071-0000.dts) maps UPHY0 lanes 4,5 to PCIe-C2
# and 6,7 to MPHY, with no C3 entry; the BPMP's uphy0-config is what assigns
# the C3 lanes, so leaving the static BCT in place would only conflict.
CARRIER_FV_UPHY_CONFIG=""
CARRIER_ENV_ODMDATA="uphy0-config-6,pcie@3_status=okay"

# --- T4000 module selection -------------------------------------------------
#
# The MACHINE bakes the T5000 (P3834-0008) everywhere; each line below moves one
# flashvar to its P3834-0000 counterpart. Getting these wrong is not a soft
# failure — SDRAM training and PMIC config are per-module.

# Kernel DTB. Present in BOTH flashvars (DTB_FILE) and .env.initrd-flash
# (DTBFILE); initrd-flash reads the env copy, tegraflash the flashvar, so both
# must move together. This is Advantech's own pre-patched T4000 DTB name — but
# note we apply the carrier overlay to the STOCK DTB rather than shipping their
# fork, exactly as on the MIC-743.
CARRIER_FV_DTB_FILE="tegra264-p4071-0000+p3834-0000-nv.dtb"
CARRIER_ENV_DTBFILE="tegra264-p4071-0000+p3834-0000-nv.dtb"

# BPMP. The firmware blob is a different part (TE1070M vs the T5000's
# TA1090SA) and ships in tegraflash-bsp already. The DTB is generated here:
# stock tegra264-bpmp-3834-0000-4071-xxxx.dtb with the same two properties the
# MIC-743's carries: /pcie/pcie@3 status okay and /uphy/uphy0-config 0x07 ->
# 0x06. Both are module-SKU independent carrier settings.
CARRIER_FV_BPFDTB_FILE="tegra264-bpmp-3834-0000-4071-xxxx-adv.dtb"
CARRIER_FV_BPF_FILE="bpmp_t264-TE1070M-A1_prod.bin"

# SDRAM: cold-boot BCT, warmboot BCT, and the BPMP DFS table. RAMCODE selects
# the strap index within them — 0 on the T4000, 12 on the T5000. BCTFILE is the
# flashvar spelling; EMC_BCT is the .env.initrd-flash spelling of the same file.
CARRIER_FV_BCTFILE="tegra264-p3834-0000-sdram-bct-l4t.dts"
CARRIER_ENV_EMC_BCT="tegra264-p3834-0000-sdram-bct-l4t.dts"
CARRIER_FV_WB0SDRAM_BCT="tegra264-p3834-0000-sdram-bct-warmboot-l4t.dts"
CARRIER_FV_BPMP_MEM_CONFIG="tegra264-p3834-0000-sdram-dfs.dts"
CARRIER_FV_RAMCODE="0"

# Per-module MB1 BCTs.
CARRIER_FV_PMIC_CONFIG="tegra264-mb1-bct-pmic-p3834-0000-p4071-0000.dts"
CARRIER_FV_MISC_CONFIG="tegra264-mb1-bct-misc-p3834-0000-p4071-0000.dts"

# Chip SKU fused into the T4000 part; tegraflash refuses to boot MB1 if this
# does not match what the silicon reports.
CARRIER_FV_CHIP_SKU="00:00:00:E2"

# Module SKU gate — pins this extension to the T4000 so installing it on a
# T5000 fails fast at the tegraflash board-ID check rather than mis-flashing.
# (Advantech sets SKIP_EEPROM_CHECK=1; we do not — the prod-BCT I2C1 fix is
# what makes the SoM EEPROM readable, so this check should pass.)
CARRIER_FV_CHECK_BOARDID="3834"
CARRIER_FV_CHECK_BOARDSKU="0000"
